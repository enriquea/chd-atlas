{
  "$defs": {
    "Archive": {
      "enum": [
        "pride",
        "geo",
        "arrayexpress",
        "ega"
      ],
      "title": "Archive",
      "type": "string"
    },
    "Contrast": {
      "additionalProperties": false,
      "description": "A named comparison within a dataset.\n\nA fold change is uninterpretable without knowing what was compared to what,\nso contrasts are modelled explicitly rather than left as a free-text column.",
      "properties": {
        "case_group": {
          "minLength": 1,
          "title": "Case Group",
          "type": "string"
        },
        "control_group": {
          "minLength": 1,
          "title": "Control Group",
          "type": "string"
        },
        "covariates": {
          "items": {
            "type": "string"
          },
          "title": "Covariates",
          "type": "array"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "software": {
          "minLength": 1,
          "title": "Software",
          "type": "string"
        },
        "statistical_method": {
          "minLength": 1,
          "title": "Statistical Method",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description",
        "case_group",
        "control_group",
        "statistical_method",
        "software"
      ],
      "title": "Contrast",
      "type": "object"
    },
    "DatasetDesign": {
      "description": "Whether a dataset's rows are contrasts or abundances.\n\nDeclared rather than inferred from `len(contrasts)`, so a curator who\nforgot the contrasts is distinguishable from an abundance atlas that\ncorrectly has none.",
      "enum": [
        "contrast",
        "profile"
      ],
      "title": "DatasetDesign",
      "type": "string"
    },
    "Stage": {
      "additionalProperties": false,
      "description": "One of a dataset's own stage tokens, with its position in development.\n\n`wpc` is null post-natally, which is not a gap: a post-natal stage is\noutside every cardiac morphogenetic phase by definition, and the page says\nso rather than dropping the row.\n\n`order` is the curated chronological position, 1-based and ascending, and\nis what every renderer sorts on. It is **required and not defaulted**,\nbecause `wpc` cannot do this job: it is null for every post-natal stage,\nso a dataset's post-natal tokens have no numeric order at all. Sorting\nthose tokens as strings is what published `elderly` second of eight and\n`4 week post conception` after `19 week post conception` -- deterministic,\nreproducible and wrong, under schema 2.11.\n\n**2.11 and no other version**, measured rather than estimated: the\nprofiles mirror was first committed on 2026-08-19, and before it a gene\nbundle's `expression_profile` was `{\"datasets\": []}` with no stage array\npublished at all. So the dictionary order reached published bytes under\nexactly one schema version, promoted to `main` that same day and corrected\nthe next.\n\nChosen over sorting by position in the YAML file, which would make\ndeclaration order silently load-bearing: a curator tidying the block would\nchange published output with nothing flagging it.",
      "properties": {
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "token": {
          "minLength": 1,
          "title": "Token",
          "type": "string"
        },
        "wpc": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wpc"
        }
      },
      "required": [
        "token",
        "order"
      ],
      "title": "Stage",
      "type": "object"
    },
    "Technology": {
      "enum": [
        "bulk_rnaseq",
        "scrnaseq",
        "microarray",
        "tmt_ms",
        "lfq_ms",
        "phosphoproteomics"
      ],
      "title": "Technology",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Top level of ``curation/datasets/<ACCESSION>.yaml``.",
  "properties": {
    "archive": {
      "$ref": "#/$defs/Archive"
    },
    "cardiac_tissues": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Cardiac Tissues",
      "type": "array"
    },
    "contrasts": {
      "items": {
        "$ref": "#/$defs/Contrast"
      },
      "title": "Contrasts",
      "type": "array"
    },
    "design": {
      "$ref": "#/$defs/DatasetDesign"
    },
    "detection_floor": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detection Floor"
    },
    "developmental_stage": {
      "minLength": 1,
      "title": "Developmental Stage",
      "type": "string"
    },
    "floor_source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Floor Source"
    },
    "id": {
      "pattern": "^(PXD\\d{6,}|GSE\\d+|E-[A-Z]{4}-\\d+|EGA[SD]\\d{11})$",
      "title": "Id",
      "type": "string"
    },
    "licence": {
      "minLength": 1,
      "title": "Licence",
      "type": "string"
    },
    "n_samples": {
      "minimum": 2,
      "title": "N Samples",
      "type": "integer"
    },
    "organism": {
      "pattern": "^NCBITaxon:\\d+$",
      "title": "Organism",
      "type": "string"
    },
    "publication": {
      "anyOf": [
        {
          "pattern": "^PMID:\\d+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publication"
    },
    "quantile_estimator": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quantile Estimator"
    },
    "stages": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Stage"
      },
      "title": "Stages",
      "type": "array"
    },
    "technology": {
      "$ref": "#/$defs/Technology"
    },
    "tissue": {
      "minLength": 1,
      "title": "Tissue",
      "type": "string"
    }
  },
  "required": [
    "id",
    "archive",
    "technology",
    "tissue",
    "developmental_stage",
    "organism",
    "n_samples",
    "licence",
    "design"
  ],
  "title": "Dataset",
  "type": "object"
}
