{
  "$defs": {
    "LesionGroup": {
      "enum": [
        "conotruncal",
        "septal",
        "lvoto",
        "rvoto",
        "avsd",
        "heterotaxy",
        "anomalous_venous_return",
        "complex",
        "other"
      ],
      "title": "LesionGroup",
      "type": "string"
    },
    "PhenotypeTerm": {
      "additionalProperties": false,
      "description": "One HPO term the atlas cites, cardiac or not.\n\n`lesion_group` is `None` for a term that is not itself a cardiac lesion --\nan extracardiac feature registered here only so `validate_labels` can check\nits transcription, the same guarantee every cardiac term already gets.\n`None` here is why `validate/referential.py`'s REF010 does not flag such a\nterm when an assertion cites it under `extracardiac_features`: that check\nreads `is not None`, so only a term that *is* a cardiac lesion group can\nmake an assertion look internally inconsistent.",
      "properties": {
        "id": {
          "pattern": "^(HP|MONDO):\\d{7}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "lesion_group": {
          "anyOf": [
            {
              "$ref": "#/$defs/LesionGroup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "synonyms": {
          "items": {
            "type": "string"
          },
          "title": "Synonyms",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "PhenotypeTerm",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Top level of ``curation/phenotypes.yaml``.",
  "properties": {
    "phenotypes": {
      "items": {
        "$ref": "#/$defs/PhenotypeTerm"
      },
      "minItems": 1,
      "title": "Phenotypes",
      "type": "array"
    }
  },
  "required": [
    "phenotypes"
  ],
  "title": "PhenotypeFile",
  "type": "object"
}
