          },
          "title": "Synonyms",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "lesion_group"
      ],
      "title": "PhenotypeTerm",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Top level of ``curation/phenotypes.yaml``.",
  "properties": {
    "phenotypes": {
      "items": {
        "$ref": "#/$defs/PhenotypeTerm"
      },
      "minItems": 1,
      "title": "Phenotypes",
      "type": "array"
    }
  },
  "required": [
    "phenotypes"
  ],
  "title": "PhenotypeFile",
  "type": "object"
}
