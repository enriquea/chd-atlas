{
  "$defs": {
    "LesionGroup": {
      "enum": [
        "conotruncal",
        "septal",
        "lvoto",
        "rvoto",
        "avsd",
        "heterotaxy",
        "anomalous_venous_return",
        "complex",
        "other"
      ],
      "title": "LesionGroup",
      "type": "string"
    },
    "PhenotypeTerm": {
